# ==================================================================== WEBSITE SETTINGS
# SETTINGS. Copy to settings/.env (never commit .env). On Vercel, add every line below under
# Project → Settings → Environment Variables, then Redeploy (VITE_ values are built into the page).
# Everything here ends up in the public JavaScript: never put a private key or secret here.

# --- Wallet / network (kitbox). Test project id of Nutt: replace with the client's own before launch.
VITE_PROJECT_ID=4b2194bd0448ba60db7cf89f36a94c0f
VITE_CHAIN=bsc

# --- Name, texts and domain (used in <head>, header, footer and share previews)
VITE_APP_NAME=Moon World
VITE_APP_TAGLINE=Play & Prosper
VITE_APP_DESCRIPTION=Moon World is an NFT gaming universe with its own token, MWLD. Play, battle and prosper with blockchain rewards on BNB Chain.
VITE_SITE_URL=https://moonworld.app

# --- Maintenance page: on | off. Bypass word: open ?bypass=<word> to see the real site in that tab.
VITE_MAINTENANCE=off
VITE_MAINTENANCE_MESSAGE=
VITE_MAINTENANCE_BYPASS=

# --- Token (name, symbol, decimals and total supply are read from this contract on chain)
VITE_TOKEN_ADDRESS=0x7c25440667c23873d7C61aA12dF669783ee16aB8

# --- Links
VITE_CLAIM_URL=https://presale.moonworld.app
VITE_SWAP_URL=https://pancakeswap.finance/swap?chain=bsc&outputCurrency=0x7c25440667c23873d7C61aA12dF669783ee16aB8
VITE_CHART_URL=https://dexscreener.com/bsc/0xe52e8a4eebb63b2580e1f2ecb020d49e40ae8568
VITE_SECURITY_REPORT_URL=https://gopluslabs.io/token-security/56/0x7c25440667c23873d7C61aA12dF669783ee16aB8
VITE_SUPPORT_EMAIL=support@moonworld.app
# Social links: leave empty to hide that icon
VITE_TELEGRAM_URL=
VITE_FACEBOOK_URL=
VITE_YOUTUBE_URL=

# --- Tokenomics shown on the page (percent values are plain numbers, e.g. 10 = 10%)
VITE_PRESALE_AMOUNT=2100000
VITE_TGE_UNLOCK_PERCENT=10
VITE_MONTHLY_UNLOCK_PERCENT=2.5
VITE_REWARD_POOL_PERCENT=5

# --- Liquidity facts from the security scan (GoPlus, Nov 2026). Date is YYYY-MM-DD (UTC).
VITE_DEX_NAME=PancakeSwap V2
VITE_LP_LOCKER=PinkLock
VITE_LP_LOCKED_PERCENT=90
VITE_LP_BURNED_PERCENT=10
VITE_LP_LOCKED_UNTIL=2027-06-05
VITE_SECURITY_SCAN_DATE=2026-11-26
